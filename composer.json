{
    "name": "ljguo-latex/dingtalk-robot",
    "description": "DingTalk (钉钉) Robot SDK for PHP — fluent API, all message types, signature support",
    "type": "library",
    "license": "MIT",
    "keywords": ["dingtalk", "robot", "sdk", "webhook", "钉钉"],
    "authors": [
        {
            "name": "ljguo",
            "email": "ljguo1020@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DingTalk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DingTalk\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
